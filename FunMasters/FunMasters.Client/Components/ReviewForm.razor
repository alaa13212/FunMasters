@using FunMasters.Shared.DTOs
@using System.Globalization

<EditForm Model="Model" method="post" OnValidSubmit="OnValidSubmit" FormName="@FormName">
    <DataAnnotationsValidator/>
    <fieldset class="fieldset">
        <legend class="fieldset-legend">Score</legend>
        @* The dial is drawn over a transparent native range input: a real slider thumb cannot
           contain text, but the input must stay for dragging, keyboard and accessibility. *@
        <div class="fm-range @(_active ? "is-active" : "")" style="--fm-pct:@Percent">
            <div class="fm-range-track">
                <div class="fm-range-fill"></div>
            </div>
            <div class="fm-range-thumb">
                <span class="fm-range-value">@(Model.HasScore ? Model.Score.ToString("0.#", CultureInfo.InvariantCulture) : "--")</span>
                <span class="fm-range-word">@(Model.HasScore ? Model.GetRatingLabel() : "")</span>
            </div>
            <input type="range" @bind="Model.Score" @bind:event="oninput"
                   min="0.1" max="10" step="0.1"
                   aria-label="Score"
                   @onpointerdown="Engage" @onpointerup="Release" @onpointercancel="Release"
                   @onfocus="Engage" @onblur="Release"/>
        </div>
    </fieldset>
    <fieldset>
        <legend class="fieldset-legend">Comment</legend>
        <InputTextArea @bind-Value="Model.Comment"
                       id="@("rate-comment-" + FormName)"
                       class="textarea min-h-24 w-full" placeholder="Optional"/>
    </fieldset>
    <div class="form-floating mb-3">
        <label for="@("rate-comment-" + FormName)" class="form-label"></label>
    </div>
    <fieldset class="fieldset">
        <legend class="fieldset-legend">Hours Played</legend>
        <input type="number" @bind="Model.PlaytimeHours" @bind:event="oninput"
               class="input w-full" min="0" step="0.1" placeholder="Optional"/>
    </fieldset>
    <div>
        <button type="submit" class="btn btn-lg btn-primary w-full mt-3" disabled="@Model.IsSubmitting">
            @if (Model.IsSubmitting)
            {
                <span class="loading loading-spinner"></span>
            }
            @SubmitLabel
        </button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public ReviewFormModel Model { get; set; } = null!;
    [Parameter, EditorRequired] public string FormName { get; set; } = null!;
    [Parameter] public string SubmitLabel { get; set; } = "Rate";
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }

    private bool _active;

    private void Engage() => _active = true;
    private void Release() => _active = false;

    /// Position along the track, 0-100. The range runs 0.1 to 10, not 0 to 10.
    private string Percent =>
        ((double)((Model.Score - 0.1m) / 9.9m) * 100).ToString("0.##", CultureInfo.InvariantCulture);
}
