@page "/game/active"
@page "/game/{Id:guid}"
@using System.Security.Claims
@inject ISuggestionApiService SuggestionApi
@inject IRatingApiService RatingApi
@inject IHltbApiService HltbApi
@inject ISteamApiService SteamApi
@inject IGemApiService GemApi
@inject NavigationManager NavigationManager

<div class="m-5">

    @if (Game == null && !_loading)
    {
        <PageTitle>404 Not Found</PageTitle>
        <h4>Game not found 404</h4>
    }
    else if (Game != null)
    {
        <PageTitle>@Game.Suggestion.Title</PageTitle>
        <div class="flex items-start flex-col lg:flex-row gap-5">
            <div class="card bg-base-200 shadow-md flex-none w-full lg:w-128 @("@container")">
                <figure class="max-h-[340px] hover:max-h-[700px] can-hover:max-h-[700px] transition-all duration-300">
                    <img src="@Game.Suggestion.CoverImageUrl" alt="@Game.Suggestion.Title" class="w-full"/>
                </figure>
                <div class="card-body">
                    <div class="card-title flex flex-col md:flex-row justify-between items-center">
                        <h3 class="text-4xl text-primary">@Game.Suggestion.Title</h3>

                        @if (Game.Suggestion.AverageRating.HasValue)
                        {
                            <div class="flex md:flex-row-reverse items-center">
                                <RatingStars Rating="@Game.Suggestion.AverageRating.Value"
                                             class="mx-2 text-5xl md:text-4xl"/>
                                <span
                                    class="max-md:w-0 text-4xl md:text-3xl text-primary">@(Game.Suggestion.AverageRating?.ToString("0.#") ?? "0")<small>/10</small></span>
                            </div>
                        }
                    </div>
                    <div class="flex flex-row justify-between items-center">
                        <div class="h-max">
                            Suggested By
                            <br/>
                            <strong class="text-lg my-2 flex flex-row gap-3 items-center"><img src="@Game.Suggestion.SuggestedByAvatarUrl" class="md:ms-1  my-2 w-10 h-10 mask mask-squircle"/>
                                <a href="/funmaster/@Game.Suggestion.SuggestedById">@Game.Suggestion.SuggestedByUserName</a>
                                <UserBadgeDisplay Badges="@Game.Suggestion.SuggestedByBadges" UserId="@Game.Suggestion.SuggestedById" SizePx="28"/>
                            </strong>
                        </div>
                        <div class="flex flex-wrap gap-2 justify-end">
                            <div>
                                <a href="@HltbLink()" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-accent gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    HowLongToBeat
                                </a>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Game.Suggestion.SteamLink))
                            {
                                <div>
                                    <a href="@Game.Suggestion.SteamLink" target="_blank" rel="noopener noreferrer"
                                       class="btn btn-primary gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                             viewBox="0 0 496 512" fill="currentColor">
                                            <path
                                                d="M496 256c0 137-111.2 248-248.4 248-113.8 0-209.6-76.3-239-180.4l95.2 39.3c6.4 32.1 34.9 56.4 68.9 56.4 39.2 0 71.9-32.4 70.2-73.5l84.5-60.2c52.1 1.3 95.8-40.9 95.8-93.5 0-51.6-42-93.5-93.7-93.5s-93.7 42-93.7 93.5v1.2L176.6 279c-15.5-.9-30.7 3.4-43.5 12.1L0 236.1C10.2 108.4 117.1 8 247.6 8 384.8 8 496 119 496 256zM155.7 384.3l-30.5-12.6a52.79 52.79 0 0 0 27.2 25.8c26.9 11.2 57.8-1.6 69-28.4 5.4-13 5.5-27.3.1-40.3-5.4-13-15.5-23.2-28.5-28.6-12.9-5.4-26.7-5.2-38.9-.6l31.5 13c19.8 8.2 29.2 30.9 20.9 50.7-8.3 19.9-31 29.2-50.8 21zm173.8-129.9c-34.4 0-62.4-28-62.4-62.3s28-62.3 62.4-62.3 62.4 28 62.4 62.3-27.9 62.3-62.4 62.3zm.1-15.6c25.9 0 46.9-21 46.9-46.8 0-25.9-21-46.8-46.9-46.8s-46.9 21-46.9 46.8c.1 25.8 21.1 46.8 46.9 46.8z"/>
                                        </svg>
                                        Steam
                                    </a>
                                </div>
                            }
                        </div>

                    </div>
                    @if (Game.Suggestion.ActiveAtUtc <= DateTime.UtcNow)
                    {
                        @if (Game.Suggestion.FinishedAtUtc > DateTime.UtcNow)
                        {
                            <div class="flex flex-col items-center content-center">
                                <h3 class="divider text-3xl ">Playing <span class="text-[#F00] font-mono">Dead</span>line
                                </h3>
                                <Countdown EndDate="@Game.Suggestion.FinishedAtUtc.Value" class="md:w-max"/>
                            </div>
                        }
                    }
                    @if (Game.Suggestion.ActiveAtUtc > DateTime.UtcNow)
                    {
                        <div class="flex flex-col items-center content-center">
                            <h3 class="divider text-3xl ">Starting in:</h3>
                            <Countdown EndDate="@Game.Suggestion.ActiveAtUtc.Value" class="md:w-max"/>
                        </div>
                    }
                    @if (!Game.Suggestion.ActiveAtUtc.HasValue)
                    {
                        <div class="flex flex-col items-center content-center">
                            <h3 class="divider text-3xl ">Game is not queued!</h3>
                        </div>
                    }
                    <HowLongToBeat HltbData="HltbData" HltbLoading="_hltbLoading"/>
                </div>
            </div>
            <div class="flex-1 max-lg:w-full">
                <div class="text-5xl my-6">Reviews</div>
                <div class="card bg-base-200 shadow-md m-auto w-full @("@container")">
                    <div class="card-body">
                        @if (_canRate)
                        {
                            <div class="divider text-2xl">Finished Playing? - Rate this game</div>
                            <div class="max-w-[650px] w-full mx-auto">
                                <ReviewForm Model="_ratingRecord"
                                            FormName="@("rate-" + Game.Suggestion.Id.ToString("n"))"
                                            SubmitLabel="Rate"
                                            OnValidSubmit="RateGame"/>
                            </div>
                            <div class="divider"></div>
                        }
                        @if (!Game.Ratings.Any())
                        {
                            <span class="text-center text-xl">No reviews yet</span>
                        }
                        <div class="columns-[450px] gap-5">
                            @foreach (var ratingModel in _ratingViewModels)
                            {
                                var rating = ratingModel.Rating;
                                <div class="flex flex-col transition-all duration-300 mb-5 break-inside-avoid @(IsGemLeader(rating) ? "gem-leader" : "")">
                                    <div class="flex flex-row">
                                        <img src="@rating.RaterAvatarUrl" class="me-2 w-25 h-25 mask mask-squircle"/>
                                        <div class="flex flex-col gap-2">
                                            <h5 class="text-xl underline"><a href="/funmaster/@rating.RaterId">@rating.RaterUserName</a><UserBadgeDisplay Badges="@rating.RaterBadges" UserId="@rating.RaterId" SizePx="18"/></h5>
                                            <RatingStars Rating="@rating.DecimalScore" class="text-3xl"/>
                                            <div class="flex items-center gap-2 flex-wrap">
                                                @if (rating.GemCount > 0)
                                                {
                                                    <span class="text-warning text-sm" title="@($"{rating.GemCount} gem(s)")">
                                                        💎 @rating.GemCount
                                                    </span>
                                                }
                                                @if (Game!.MyGemRatingId == rating.Id)
                                                {
                                                    <span class="badge badge-warning badge-sm">Your gem</span>
                                                }
                                                else if (Game.CanAwardGem && rating.RaterId != _myId)
                                                {
                                                    @* Two steps on purpose: a gem cannot be withdrawn. *@
                                                    @if (_confirmingGemFor == rating.Id)
                                                    {
                                                        <button class="btn btn-warning btn-xs" disabled="@_awardingGem"
                                                                @onclick="() => AwardGem(rating)">
                                                            Confirm — this cannot be undone
                                                        </button>
                                                        <button class="btn btn-ghost btn-xs" disabled="@_awardingGem"
                                                                @onclick="() => { _confirmingGemFor = null; _gemError = null; }">
                                                            Cancel
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-outline btn-warning btn-xs"
                                                                @onclick="() => { _confirmingGemFor = rating.Id; _gemError = null; }">
                                                            💎 Award gem
                                                        </button>
                                                    }
                                                }
                                                @if (rating.RaterId == _myId)
                                                {
                                                    <button type="button" class="btn btn-ghost btn-xs gap-1 px-1"
                                                            aria-label="Edit your review"
                                                            @onclick="() => _editingReview = rating">
                                                        <svg viewBox="0 0 16 16" fill="currentColor" class="w-3.5 h-3.5">
                                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                        </svg>
                                                        Edit
                                                    </button>
                                                }
                                            </div>
                                            @if (_gemError != null && _confirmingGemFor == rating.Id)
                                            {
                                                <span class="text-error text-sm">@_gemError</span>
                                            }
                                            @if (rating.PlaytimeForeverMinutes.HasValue || rating.Playtime2WeeksMinutes.HasValue)
                                            {
                                                <a href="@rating.RaterSteamProfileUrl" target="_blank" rel="noopener noreferrer"
                                                   class="text-sm opacity-70 hover:opacity-100 flex items-center gap-1 w-fit @(rating.RaterSteamProfileUrl == null ? "pointer-events-none" : "") @(rating.PlaytimeForeverMinutes < 60 ? "text-warning" : "")">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                                    </svg>
                                                    @rating.PlaytimeForeverDisplay total
                                                    @if (rating.Playtime2WeeksMinutes.HasValue && rating.Playtime2WeeksMinutes != rating.PlaytimeForeverMinutes)
                                                    {
                                                        <span>(@rating.Playtime2WeeksDisplay at finish)</span>
                                                    }
                                                </a>
                                            }
                                            <span class="spoiler-text @(ratingModel.IsSpoiler ? "spoiler-on" : "")"@onclick="() => ratingModel.IsSpoiler = false">
                                                @rating.DecimalScore/10 @rating.RatingLabel.<br/>
                                                @if(!string.IsNullOrWhiteSpace(rating.Comment))
                                                {
                                                    <CollapsibleReview Review="@rating.Comment"/>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (Game.NonReviewerPlaytimes.Any())
                        {
                            <div class="divider text-lg opacity-70">Also Played</div>
                            <div class="flex flex-wrap gap-3">
                                @foreach (var pt in Game.NonReviewerPlaytimes)
                                {
                                    <a href="@pt.SteamProfileUrl" target="_blank" rel="noopener noreferrer"
                                       class="flex items-center gap-2 bg-base-300 rounded-lg px-3 py-2 hover:bg-base-300/50 transition-colors @(pt.SteamProfileUrl == null ? "pointer-events-none" : "") @(pt.PlaytimeForeverMinutes < 60 ? "text-warning" : "")">
                                        <img src="@pt.AvatarUrl" class="w-8 h-8 mask mask-squircle"/>
                                        <div class="flex flex-col">
                                            <span class="text-sm font-semibold">@pt.UserName</span>
                                            @if (pt.HasData)
                                            {
                                                <span class="text-xs opacity-70">
                                                    @pt.PlaytimeForeverDisplay total
                                                    @if (pt.Playtime2WeeksMinutes.HasValue && pt.Playtime2WeeksMinutes != pt.PlaytimeForeverMinutes)
                                                    {
                                                        <span>(@pt.Playtime2WeeksDisplay @(Game.Suggestion.Status == SuggestionStatus.Active? " last 2 weeks" : "at finish"))</span>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-xs opacity-50">Playtime unavailable</span>
                                            }
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (_editingReview != null)
        {
            @* The active window only means anything once the title has been before the Council. *@
            <EditReviewModal Rating="_editingReview"
                             GameTitle="@Game.Suggestion.Title"
                             ShowPlaytime2Weeks="@(Game.Suggestion.Status is SuggestionStatus.Active
                                                                   or SuggestionStatus.Finished)"
                             OnSaved="ReviewSaved"
                             OnClosed="@(() => _editingReview = null)"/>
        }
    }
</div>


@code {
    [Parameter, SupplyParameterFromQuery] public Guid Id { get; set; }

    [PersistentState] public SuggestionDetailDto? Game { get; set; }
    [PersistentState] public HltbGameResultDto? HltbData { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid? _myId;
    private bool _loading = true;
    private bool _canRate;

    private ReviewFormModel _ratingRecord = new();

    private List<GameRatingViewModel> _ratingViewModels = [];
    private bool _hltbLoading = true;

    private Guid? _confirmingGemFor;
    private bool _awardingGem;
    private string? _gemError;

    /// <summary>The verdict the quick-edit popup is currently open on, or null when it is closed.</summary>
    private RatingDto? _editingReview;

    /// <summary>
    /// Re-reads the page rather than mirroring the saved form: the server decides what a hand-typed
    /// playtime is worth, and the page re-syncs every playtime from Steam on load anyway.
    /// </summary>
    private void ReviewSaved()
    {
        _editingReview = null;
        NavigationManager.Refresh(true);
    }

    /// <summary>
    /// The review (or reviews, when tied) holding the most gems for this title. Decided here
    /// rather than on the server so the bar moves the instant a gem is awarded.
    /// </summary>
    private bool IsGemLeader(RatingDto rating)
    {
        if (rating.GemCount == 0) return false;
        return rating.GemCount == Game!.Ratings.Max(r => r.GemCount);
    }

    private async Task AwardGem(RatingDto rating)
    {
        _awardingGem = true;
        _gemError = null;
        try
        {
            var result = await GemApi.AwardGemAsync(new AwardGemRequest { RatingId = rating.Id });
            if (result.Success)
            {
                rating.GemCount = result.Data;
                Game!.MyGemRatingId = rating.Id;
                Game.CanAwardGem = false;
                _confirmingGemFor = null;
            }
            else
            {
                _gemError = result.ErrorMessage;
            }
        }
        catch (Exception)
        {
            // Never let this escape: the button says the gem cannot be undone, so the reader must
            // be told what happened rather than meeting the unhandled-error bar.
            _gemError = "The Council could not record your gem. Please try again.";
        }
        finally
        {
            _awardingGem = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            var authState = await AuthenticationStateTask!;
            if (authState.User.Identity?.IsAuthenticated == true)
                _myId = Guid.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;

            if (Game == null)
            {
                if (Id == Guid.Empty)
                    Game = await SuggestionApi.GetActiveSuggestionAsync();
                else
                    Game = await SuggestionApi.GetSuggestionDetailsAsync(Id);
                StateHasChanged();
            }

            if (Game != null)
            {
                // Sort ratings: those with comments first, then by creation date
                var sortedRatings = Game.Ratings
                    .OrderByDescending(r => string.IsNullOrWhiteSpace(r.Comment) ? -1 : Math.Clamp(r.Comment.Length, 0, 1))
                    .ThenBy(r => r.CreatedAtUtc)
                    .ToList();

                Game.Ratings = sortedRatings;

                bool hasNoRatings = _myId != null && Game.Ratings.All(r => r.RaterId != _myId);

                _ratingViewModels = Game.Ratings
                    .Select(r => new GameRatingViewModel(r, hasNoRatings || (_myId == null && Game.Suggestion.Status == SuggestionStatus.Active)))
                    .ToList();

                _canRate = hasNoRatings && Game.Suggestion.Status is SuggestionStatus.Active or SuggestionStatus.Finished;
                if (_canRate)
                    _ratingRecord = new ReviewFormModel
                    {
                        ShowPlaytime2Weeks = ReviewFormModel.HasActiveWindow(Game.Suggestion.Status)
                    };
                
                StateHasChanged();

                try
                {
                    HltbData ??= await HltbApi.SearchGameAsync(Game.Suggestion.Title);
                    StateHasChanged();
                }
                catch (Exception)
                {
                    HltbData = null;
                }
                finally
                {
                    _hltbLoading = false;
                }

                // Auto-refresh all playtimes on load
                await AutoRefreshPlaytimesAsync();
            }
        }
        catch (Exception)
        {
            // Handle error
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task RateGame()
    {
        if (Game == null || _myId == null)
            return;

        _ratingRecord.IsSubmitting = true;

        try
        {
            var request = new CreateRatingRequest
            {
                SuggestionId = Game.Suggestion.Id,
                Score = (int)(_ratingRecord.Score * 10),
                Comment = _ratingRecord.Comment,
                ManualPlaytimeMinutes = _ratingRecord.PlaytimeHours.HasValue
                    ? (int)(_ratingRecord.PlaytimeHours.Value * 60)
                    : null,
                ManualPlaytime2WeeksMinutes = _ratingRecord.ShowPlaytime2Weeks
                                              && _ratingRecord.Playtime2WeeksHours.HasValue
                    ? (int)(_ratingRecord.Playtime2WeeksHours.Value * 60)
                    : null
            };

            var result = await RatingApi.CreateRatingAsync(request);

            if (result.Success)
            {
                NavigationManager.Refresh(true);
            }
        }
        catch (Exception)
        {
            // Handle error
        }
        finally
        {
            _ratingRecord.IsSubmitting = false;
        }
    }

    private async Task AutoRefreshPlaytimesAsync()
    {
        if (Game == null)
            return;
        
        try
        {
            var result = await SteamApi.RefreshPlaytimesAsync(Game.Suggestion.Id);
            if (result.Success && result.Data != null)
            {
                foreach (var pt in result.Data)
                    ApplyPlaytimeUpdate(pt);
                StateHasChanged();
            }
        }
        catch { /* ignore */ }
    }

    private void ApplyPlaytimeUpdate(SteamPlaytimeDto pt)
    {
        var ratingVm = _ratingViewModels.FirstOrDefault(r => r.Rating.RaterId == pt.UserId);
        if (ratingVm != null)
        {
            ratingVm.Rating.PlaytimeForeverMinutes = pt.PlaytimeForeverMinutes;
            ratingVm.Rating.Playtime2WeeksMinutes = pt.Playtime2WeeksMinutes;
        }
        else
        {
            var existing = Game!.NonReviewerPlaytimes.FirstOrDefault(p => p.UserId == pt.UserId);
            if (existing != null)
            {
                existing.PlaytimeForeverMinutes = pt.PlaytimeForeverMinutes;
                existing.Playtime2WeeksMinutes = pt.Playtime2WeeksMinutes;
            }
            else
            {
                Game!.NonReviewerPlaytimes.Add(pt);
            }
        }
    }

    private string HltbLink()
    {
        return HltbData?.GameUrl ?? $"https://howlongtobeat.com/?q={Game?.Suggestion.Title}";
    }

    private class GameRatingViewModel(RatingDto rating, bool isSpoiler)
    {
        public RatingDto Rating { get; set; } = rating;
        public bool IsSpoiler { get; set; } = isSpoiler;
    }

}