@page "/funmaster/{UserId:guid}"
@using FunMasters.Client.Components
@using System.Security.Claims
@inject IAccountApiService AccountApi
@inject NavigationManager Nav

<PageTitle>@(_profile?.UserName ?? "Fun Master")</PageTitle>

<div class="m-5">
    @if (_loading)
    {
        <p>Loading...</p>
    }
    else if (_profile == null)
    {
        <h3>Fun Master not found</h3>
    }
    else
    {
        <div class="card bg-base-200 shadow-md max-w-[800px] m-auto">
            <div class="card-body">
                <div class="flex items-center gap-4">
                    <img src="@_profile.AvatarUrl" class="w-20 h-20 mask mask-squircle"/>
                    <div>
                        <h2 class="text-3xl text-primary @(_profile.CouncilStatus == CouncilStatus.Executed ? "line-through opacity-60" : "")">@_profile.UserName</h2>
                        <div class="flex gap-1 items-center mt-1">
                            @switch (_profile.CouncilStatus)
                            {
                                case CouncilStatus.Excommunicated:
                                    <span class="badge badge-warning">Excommunicated</span>
                                    break;
                                case CouncilStatus.Executed:
                                    <span class="badge badge-error">Executed</span>
                                    break;
                                case CouncilStatus.Candidate:
                                    <span class="badge badge-info">Candidate</span>
                                    break;
                                case CouncilStatus.Shadow:
                                    <span class="badge badge-neutral">Shadow</span>
                                    break;
                            }
                            @if (_profile.TotalGems > 0)
                            {
                                <span class="badge badge-warning badge-outline" title="Gems drawn by their reviews">
                                    💎 @_profile.TotalGems
                                </span>
                            }
                            @foreach (var win in _profile.WriterOfTheCycleWins)
                            {
                                <span class="badge badge-warning"
                                      title="@($"Cycle {win.CycleNumber} — {win.GemCount} gem(s)")">
                                    Writer of Cycle @win.CycleNumber
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @if (_profile.Badges.Any())
                {
                    <div class="flex flex-wrap gap-3 mt-3">
                        @foreach (var badge in _profile.Badges)
                        {
                            <div class="flex items-center gap-2 bg-base-300 rounded-lg px-3 py-2">
                                @if (!string.IsNullOrEmpty(badge.ImageUrl))
                                {
                                    <img src="@badge.ImageUrl" alt="@badge.Name" class="w-12 h-12 hover:scale-400 transition-all object-contain"/>
                                }
                                <div>
                                    <div class="font-bold text-sm">@badge.Name</div>
                                    @if (!string.IsNullOrEmpty(badge.Description))
                                    {
                                        <div class="text-xs opacity-70">@badge.Description</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_profile.Bio))
                {
                    <div class="mt-4">
                        <h4 class="text-lg font-bold mb-1">Bio</h4>
                        <p class="whitespace-pre-wrap">@_profile.Bio</p>
                    </div>
                }

                @if (_profile.TopRatedGames.Any())
                {
                    <div class="mt-4">
                        <h4 class="text-lg font-bold mb-2">Highest Verdicts</h4>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var top in _profile.TopRatedGames)
                            {
                                <a href="/game/@top.SuggestionId"
                                   class="flex items-center gap-2 bg-base-100 rounded-box p-2 pe-3 card-hover">
                                    @if (!string.IsNullOrEmpty(top.CoverImageUrl))
                                    {
                                        <img src="@top.CoverImageUrl" alt="@top.Title"
                                             class="w-10 h-10 object-cover rounded"/>
                                    }
                                    <span>
                                        <span class="block text-sm font-bold">@top.Title</span>
                                        <span class="text-primary text-sm">@top.DecimalScore.ToString("0.#")/10</span>
                                        <span class="text-xs opacity-70">@top.RatingLabel</span>
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @* A clean sheet is not a section worth printing. *@
                @if (_profile.CriminalRecord.Total > 0)
                {
                <div class="mt-4">
                    <h4 class="text-lg font-bold mb-2">Criminal Record</h4>
                    <div class="stats stats-horizontal bg-base-100 shadow-sm">
                        <div class="stat py-3">
                            <div class="stat-title text-xs">Missed Verdicts</div>
                            <div class="stat-value text-2xl @(_profile.CriminalRecord.MissedVerdicts > 0 ? "text-error" : "opacity-50")">
                                @_profile.CriminalRecord.MissedVerdicts
                            </div>
                        </div>
                        <div class="stat py-3">
                            <div class="stat-title text-xs">Insubstantial Reviews</div>
                            <div class="stat-value text-2xl @(_profile.CriminalRecord.WeakReviews > 0 ? "text-error" : "opacity-50")">
                                @_profile.CriminalRecord.WeakReviews
                            </div>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>

        @* Best Reviews stands on its own — it is the highlight reel, not something to go looking
           for behind a tab. Absent entirely when none of their reviews have drawn a gem. *@
        @if (_profile.BestReviews.Any())
        {
            <div class="max-w-[800px] m-auto mt-6">
                <h3 class="text-2xl mb-3 flex items-center gap-2">
                    Best Reviews
                    <span class="fm-gem-count text-base">
                        <svg viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                            <path d="M3.1 1.3A.5.5 0 0 1 3.5 1h9a.5.5 0 0 1 .4.2l2.5 3.2a.5.5 0 0 1-.03.65l-7 7.5a.5.5 0 0 1-.73 0l-7-7.5A.5.5 0 0 1 .6 4.5z"/>
                        </svg>
                    </span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var review in _profile.BestReviews)
                    {
                        <ReviewedCard Model="@(new RatingModel(review))" CanEdit="false" Compact="true"/>
                    }
                </div>
            </div>
        }

        @* Radio tabs rather than Blazor state: no interactivity needed, so they work under
           static prerender exactly as they do once WASM has taken over. *@
        <div class="max-w-[800px] m-auto mt-6">
            @* Keyed on the member: without this the radio group keeps its DOM state across a
               profile switch, leaving a tab selected that the next member may not have. *@
            <div class="tabs tabs-lift" @key="UserId">

                <input type="radio" name="profile-tabs" class="tab" aria-label="Reviews" checked/>
                <div class="tab-content bg-base-100 border-base-300 p-4">
                    @if (_profile.ReviewedGames.Any())
                    {
                        <a href="/funmaster/@UserId/reviews" class="btn btn-sm btn-primary btn-outline mb-3">
                            See all @(_profile.UserName)'s Reviews
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                        <div class="space-y-2">
                            @foreach (var review in _profile.ReviewedGames.Take(ReviewsOnProfile))
                            {
                                @ReviewRow(review)
                            }
                        </div>
                    }
                    else
                    {
                        <p class="opacity-60">No verdicts delivered yet.</p>
                    }
                </div>

                <input type="radio" name="profile-tabs" class="tab" aria-label="Suggested Games"/>
                <div class="tab-content bg-base-100 border-base-300 p-4">
                @if (_profile.SuggestedGames.Any())
                {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @foreach (var game in _profile.SuggestedGames)
                    {
                        <a href="/game/@game.Id" class="card bg-base-200 shadow-sm card-hover">
                            <div class="card-body flex-row items-center gap-3 p-3">
                                @if (!string.IsNullOrEmpty(game.CoverImageUrl))
                                {
                                    <img src="@game.CoverImageUrl" alt="@game.Title" class="w-16 h-16 object-cover rounded"/>
                                }
                                <div>
                                    <h4 class="font-bold">@game.Title</h4>
                                    <span class="text-sm opacity-70">@game.Status</span>
                                    @if (game.AverageRating.HasValue)
                                    {
                                        <span class="text-sm ms-2 text-primary">@(game.AverageRating.Value.ToString("0.#"))/10</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
                }
                else
                {
                    <p class="opacity-60">No titles put before the Council yet.</p>
                }
                </div>

            </div>
        </div>

        <div class="max-w-[800px] m-auto mt-6">
            <h3 class="text-2xl mb-3">Comments</h3>

            <AuthorizeView>
                <Authorized>
                    @if (_profile.CouncilStatus != CouncilStatus.Executed)
                    {
                        <div class="mb-4">
                            <div class="flex gap-2">
                                <input type="text" class="input input-bordered flex-1" placeholder="Leave a comment..."
                                       @bind="_newComment" maxlength="1000" @bind:event="oninput"
                                       @onkeydown="OnCommentKeydown"/>
                                <button class="btn btn-primary" @onclick="SubmitComment"
                                        disabled="@(string.IsNullOrWhiteSpace(_newComment) || _submittingComment)">
                                    @if (_submittingComment)
                                    {
                                        <span class="loading loading-spinner loading-sm"></span>
                                    }
                                    Post
                                </button>
                            </div>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>

            @if (_profile.Comments.Any())
            {
                <div class="space-y-3">
                    @foreach (var comment in _profile.Comments)
                    {
                        <div class="card bg-base-200 shadow-sm">
                            <div class="card-body p-3">
                                <div class="flex items-center gap-2">
                                    <a href="/funmaster/@comment.AuthorId">
                                        <img src="@comment.AuthorAvatarUrl" class="w-8 h-8 mask mask-squircle"/>
                                    </a>
                                    <a href="/funmaster/@comment.AuthorId" class="font-bold hover:underline">@comment.AuthorUserName</a><UserBadgeDisplay Badges="@comment.AuthorBadges" UserId="@comment.AuthorId" SizePx="14"/>
                                    <span class="text-sm opacity-50">@comment.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                    @if (comment.AuthorId == _myId || _isAdmin)
                                    {
                                        <button class="btn btn-ghost btn-xs ml-auto" @onclick="() => DeleteComment(comment.Id)">x</button>
                                    }
                                </div>
                                <p class="mt-1 whitespace-pre-wrap">@comment.Text</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="opacity-70">No comments yet.</p>
            }
        </div>
    }
</div>

@code {
    /// How many verdicts the profile lists before pointing at the full page.
    private const int ReviewsOnProfile = 15;

    /// The compact list row used in the Reviews tab — deliberately not the full card, which is
    /// too heavy when it is one tab among several.
    private RenderFragment<UserRatingDto> ReviewRow => review =>
        @<a href="/game/@review.SuggestionId" class="card bg-base-200 shadow-sm card-hover block">
            <div class="card-body flex-row items-center gap-3 p-3">
                @if (!string.IsNullOrEmpty(review.CoverImageUrl))
                {
                    <img src="@review.CoverImageUrl" alt="@review.Title" class="w-16 h-16 object-cover rounded flex-shrink-0"/>
                }
                <div class="min-w-0">
                    <h4 class="font-bold">@review.Title</h4>
                    <div class="flex items-center gap-2">
                        <span class="text-primary font-bold">@review.DecimalScore.ToString("0.#")/10</span>
                        <span class="text-sm opacity-70">@review.RatingLabel</span>
                        @if (review.GemCount > 0)
                        {
                            <span class="text-warning text-sm">💎 @review.GemCount</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="text-sm opacity-70 mt-1 line-clamp-2">@review.Comment</p>
                    }
                </div>
            </div>
        </a>;


    [Parameter] public Guid UserId { get; set; }

    [PersistentState] public FunMasterProfileDto? _profile { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _loading = true;
    private string _newComment = "";
    private bool _submittingComment;
    private Guid? _myId;
    private bool _isAdmin;

    /// Who is viewing does not change as we move between profiles, so it is resolved once.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthenticationStateTask != null)
            {
                var authState = await AuthenticationStateTask;
                if (authState.User.Identity?.IsAuthenticated == true)
                {
                    _myId = Guid.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
                    _isAdmin = authState.User.IsInRole("Admin");
                }
            }
        }
        catch { }
    }

    /// <summary>
    /// Blazor keeps this component alive when only the route parameter changes — navigating from
    /// one Fun Master to another does not re-initialise it. So the profile is loaded here, and
    /// reloaded whenever the id we are holding no longer matches the one in the URL.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Already holding the right one, including the prerendered payload on first render.
        if (_profile != null && _profile.Id == UserId)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _profile = null;
        _newComment = "";

        try
        {
            _profile = await AccountApi.GetFunMasterProfileAsync(UserId);
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task SubmitComment()
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;
        _submittingComment = true;
        try
        {
            var result = await AccountApi.AddFunMasterCommentAsync(UserId, new CreateFunMasterCommentRequest { Text = _newComment });
            if (result.Success)
            {
                _newComment = "";
                _profile = await AccountApi.GetFunMasterProfileAsync(UserId);
            }
        }
        catch { }
        finally { _submittingComment = false; }
    }

    private async Task OnCommentKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SubmitComment();
        }
    }

    private async Task DeleteComment(Guid commentId)
    {
        try
        {
            var result = await AccountApi.DeleteFunMasterCommentAsync(commentId);
            if (result.Success)
                _profile = await AccountApi.GetFunMasterProfileAsync(UserId);
        }
        catch { }
    }
}
