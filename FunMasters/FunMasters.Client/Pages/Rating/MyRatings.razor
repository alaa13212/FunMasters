@page "/my-ratings"
@attribute [Authorize(Roles = "Member")]
@inject IRatingApiService RatingApi

<PageTitle>My Ratings</PageTitle>

<div class="m-5">
    <Rater NeedsRating="@NeedsRating"/>

    @if (RatingsModel is { Count: > 0 })
    {
        <h4 class="text-4xl text-center my-4">
            My Ratings
            <span class="badge badge-neutral badge-lg align-middle">@RatingsModel.Count</span>
        </h4>

        <div class="grid grid-cols-1 md:grid-cols-fill-[460px] gap-5 items-stretch">
            @foreach (var ratingModel in RatingsModel)
            {
                <ReviewedCard Model="ratingModel" OnSave="UpdateRating"/>
            }
        </div>
    }
</div>

@code {
    [PersistentState] public List<RatingModel>? RatingsModel { get; set; }
    [PersistentState] public List<NeedRatingModel>? NeedsRating { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateTask!;
            if (authState.User.Identity?.IsAuthenticated != true)
                return;

            if (!authState.User.IsInRole("Member"))
                return;

            NeedsRating ??= (await RatingApi.GetUnratedSuggestionsAsync()).Select(s => new NeedRatingModel(s)).ToList();
            RatingsModel ??= (await RatingApi.GetMyRatingsAsync()).Select(r => new RatingModel(r)).ToList();
        }
        catch (Exception)
        {
            // Handle error
        }
    }

    private async Task UpdateRating(RatingModel model)
    {
        model.Form.IsSubmitting = true;

        try
        {
            var request = new UpdateRatingRequest
            {
                Score = (int)(model.Form.Score * 10),
                Comment = model.Form.Comment,
                ManualPlaytimeMinutes = model.Form.PlaytimeHours.HasValue
                    ? (int)(model.Form.PlaytimeHours.Value * 60)
                    : null
            };

            var result = await RatingApi.UpdateRatingAsync(model.Rating.RatingId, request);

            if (result.Success)
            {
                // Re-read rather than mirror the form: the server clamps some values (manual
                // playtime can only increase), so the card must show what was actually stored.
                RatingsModel = (await RatingApi.GetMyRatingsAsync()).Select(r => new RatingModel(r)).ToList();
            }
        }
        catch (Exception)
        {
            // Handle error
        }
        finally
        {
            model.Form.IsSubmitting = false;
        }
    }
}
